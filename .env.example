# ---------------------------------------------------------------------------
# Reddit API credentials (required)
#
# Create a "script" app at https://www.reddit.com/prefs/apps
#   - type: script
#   - redirect uri: http://localhost:8080 (unused for script apps, but required)
# Then copy the client id (under the app name) and secret here.
#
# The username/password are for the SINGLE bot account this platform runs as.
# Use a dedicated account, and make sure the subreddits you target permit bots.
# ---------------------------------------------------------------------------
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USERNAME=your_bot_account_username
REDDIT_PASSWORD=your_bot_account_password

# User-agent MUST be descriptive and identify the bot + a contact.
# Reddit requires a unique, honest user-agent. Format recommended by Reddit:
#   platform:app-id:version (by /u/your_reddit_username)
REDDIT_USER_AGENT=web:reddit-helper-bot:1.0 (by /u/your_reddit_username)

# ---------------------------------------------------------------------------
# Dashboard auth (required to log in to the web UI)
# ---------------------------------------------------------------------------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-please
FLASK_SECRET_KEY=generate-a-long-random-string

# ---------------------------------------------------------------------------
# Optional: override paths
# ---------------------------------------------------------------------------
# BOT_CONFIG=config.yaml
# BOT_DB=data/bot.db
